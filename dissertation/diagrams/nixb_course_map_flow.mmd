graph TD
    subgraph Core [nixB Didactic Laboratory: Course Map]
        U1[Unit 1: The Reproducibility Gap] --> U2[Unit 2: Declarative Foundations]
        U2 --> U3[Unit 3: Local Infrastructure]
        U3 --> U4[Unit 4: Verification & Reflection]
    end

    subgraph Outcomes [Learning Outcomes]
        U1 --> LO1[LO1: Critically Analyze Failure Modes]
        U1 --> LO2[LO2: Evaluate Mental Model Gaps]
        U2 --> LO3[LO3: Construct Reproducible Envs]
        U3 --> LO4[LO4: Orchestrate IaC Stacks]
        U4 --> LO5[LO5: Verify Reproduction Fidelity]
    end

    %% Multimedia Indicators
    U1 -.-> M1((Infographic))
    U2 -.-> M2((Explainer Video))
    U3 -.-> M3((Technical Blueprint))
    U4 -.-> M4((Audio Overview))

    classDef unit fill:#f9f,stroke:#333,stroke-width:2px;
    classDef outcome fill:#bbf,stroke:#333,stroke-width:1px;
    classDef multi fill:#bfb,stroke:#333,stroke-dasharray: 5 5;

    class U1,U2,U3,U4 unit;
    class LO1,LO2,LO3,LO4,LO5 outcome;
    class M1,M2,M3,M4 multi;
